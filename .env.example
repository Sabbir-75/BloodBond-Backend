# BloodBond Backend - example only. COPY this file to a new file named ".env"
# and put your own values in it. NEVER send .env to anyone, NEVER push it to GitHub.
# (.gitignore already blocks .env.)

# Server port
PORT=5000

# SQL Server (your own PC, localhost)
DB_SERVER=localhost
DB_NAME=BloodBond

# The SQL login created in Step 2A (sql/create_login.sql)
DB_USER=bloodbond_app
DB_PASSWORD=TomarPassword123

# JWT secret - change this to your own long random text, keep it in your own note
JWT_SECRET=change-this-secret-to-your-own-long-random-text
